{
  "expo": {
    "name": "Mailroom",
    "slug": "mailroom",
    "version": "0.7.0",
    "scheme": "mailroom",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F1E3"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mailrooms.app",
      "buildNumber": "46",
      "usesAppleSignIn": true,
      "config": {
        "googleMapsApiKey": ""
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Mailroom uses your photos so you can pick one for the postcard you're sending.",
        "NSContactsUsageDescription": "Mailroom can use your contacts to help you address a postcard to a friend. Optional.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F1E3"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.mailrooms.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.mailrooms.app",
          "enableGooglePay": false
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://nlwnmgwylmmnaemdnzlq.supabase.co",
